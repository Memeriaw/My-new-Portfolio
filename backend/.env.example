# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# For Atlas, paste your connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/memeriaw_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/memeriaw_portfolio

# JWT Secret & Expiration
JWT_SECRET=memeriaw_portfolio_jwt_secret_key_super_secure_2026
JWT_EXPIRE=30d

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Default Admin Credentials (used during auto-seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Gmail contact-form notifications
# Use a Google App Password (not your regular Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: defaults to GMAIL_USER
CONTACT_NOTIFICATION_EMAIL=
